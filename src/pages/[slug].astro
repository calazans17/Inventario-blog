---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import PixelIcon from "../components/PixelIcon.astro";
import Blocks from "../components/Blocks.astro";
import { articles, categoryFor, categoryPath, clockTime, formatoLabel, longDate, nota, tagPath, url, articlePath } from "../data/content.js";

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const category = categoryFor(article);
const sameTopic = (item) => item.category === article.category || item.tags.some((tag) => article.tags.includes(tag));
const review = article.formato === "review" ? article.review : undefined;
const stars = review ? Array.from({ length: 5 }, (_, index) => Math.max(0, Math.min(1, review.nota - index))) : [];
const related = [...articles.filter((item) => item.slug !== article.slug && sameTopic(item)), ...articles.filter((item) => item.slug !== article.slug && !sameTopic(item))].slice(0, 3);
const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "NewsArticle", headline: article.title, description: article.seo.description, image: [new URL(article.image, Astro.site).href], datePublished: article.date, dateModified: article.date, author: { "@type": "Organization", name: "Somos Inventário", url: new URL(url("/"), Astro.site).href }, publisher: { "@type": "Organization", name: "Somos Inventário", url: new URL(url("/"), Astro.site).href }, mainEntityOfPage: new URL(articlePath(article), Astro.site).href },
    { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Início", item: new URL(url("/"), Astro.site).href }, { "@type": "ListItem", position: 2, name: category.name, item: new URL(categoryPath(category), Astro.site).href }, { "@type": "ListItem", position: 3, name: article.title }] },
  ],
};
---

<BaseLayout title={`${article.seo.title} — Somos Inventário`} description={article.seo.description} image={article.image} article={article} schema={articleSchema}>
  <main id="main-content" class="article-shell">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Você está em"><a href={url("/")}>Início</a><span aria-hidden="true">/</span><a href={categoryPath(category)}>{category.name}</a></nav>
      <header class="article-heading">
        <div class="article-kicker"><a class="category-label" href={categoryPath(category)}><PixelIcon name={category.icon} size={15} />{category.name}</a>{article.formato !== "materia" && <span class="format-tag">{formatoLabel(article.formato)}</span>}</div>
        <h1>{article.title}</h1>
        <p class="article-deck">{article.summary}</p>
        <div class="article-byline">
          <div class="article-published"><time datetime={article.date}>{longDate(article.date)} · {clockTime(article.date)}</time><span>{article.readingTime} min de leitura</span></div>
        </div>
      </header>
    </div>

    <figure class="article-cover container"><img src={article.image} alt={article.imageAlt} fetchpriority="high" width="1600" height="900" /><figcaption>{article.imageAlt}{article.imageCredit && <span>{article.imageCredit}</span>}</figcaption></figure>

    <div class="article-layout container">
      <article class="article-body" id="article-body">
        <Blocks blocos={article.blocos} />
        {review && (
          <section class="review-box" aria-label="Veredito">
            <div class="review-score">
              <span class="eyebrow">Nota do inventário</span>
              <strong>{nota(review.nota)}<small>/5</small></strong>
              <span class="review-stars" aria-hidden="true">{stars.map((fill) => <span style={`--fill: ${fill * 100}%`}>★</span>)}</span>
            </div>
            <div class="review-copy">
              {review.veredito && <p class="review-verdict">{review.veredito}</p>}
              <div class="review-lists">
                {review.pros.length > 0 && <div><span class="eyebrow">Amamos</span><ul>{review.pros.map((item) => <li>{item}</li>)}</ul></div>}
                {review.contras.length > 0 && <div><span class="eyebrow">Nem tanto</span><ul>{review.contras.map((item) => <li>{item}</li>)}</ul></div>}
              </div>
            </div>
          </section>
        )}
        <div class="article-footer-row">
          <div class="article-tags"><span class="eyebrow">No inventário</span>{article.tags.map((tag) => <a href={tagPath(tag)}>#{tag}</a>)}</div>
          <button class="share-button" type="button" id="share-button">Compartilhar <span aria-hidden="true">↗</span></button>
        </div>
      </article>
    </div>

    <section class="related-section container" aria-labelledby="related-title">
      <div class="section-heading"><div><span class="eyebrow">Continua no seu inventário</span><h2 id="related-title">Leia <em>também</em></h2></div></div>
      <div class="card-grid">{related.map((item, index) => <ArticleCard article={item} index={index} />)}</div>
    </section>
  </main>
</BaseLayout>

<script>
  const shareButton = document.querySelector("#share-button");
  shareButton?.addEventListener("click", async () => {
    if (navigator.share) {
      try { await navigator.share({ title: document.title, url: window.location.href }); } catch { /* cancelado */ }
      return;
    }
    await navigator.clipboard?.writeText(window.location.href);
    if (shareButton) shareButton.textContent = "Link copiado ✓";
  });
</script>
