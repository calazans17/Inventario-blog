---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import PixelIcon from "../../components/PixelIcon.astro";
import { articles, categories, categoryPath, url } from "../../data/content.js";

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const entries = articles.filter((article) => article.category === category.slug);
const schema = { "@context": "https://schema.org", "@type": "CollectionPage", name: category.name, description: category.description, url: new URL(categoryPath(category), Astro.site).href };
---

<BaseLayout title={`${category.name} — Somos Inventário`} description={category.description} currentPath={categoryPath(category)} schema={schema}>
  <main id="main-content" class="archive-page container">
    <nav class="breadcrumbs" aria-label="Você está em"><a href={url("/")}>Início</a><span aria-hidden="true">/</span><span>Assuntos</span></nav>
    <header class="archive-heading archive-heading--icon"><PixelIcon name={category.icon} size={88} class="archive-icon" /><div><span class="eyebrow">Um recorte do nosso universo</span><h1>{category.name}</h1><p>{category.description}</p><span class="archive-count">{entries.length} {entries.length === 1 ? "história" : "histórias"} no arquivo</span></div></header>
    <div class="card-grid">{entries.map((article, index) => <ArticleCard article={article} index={index} />)}</div>
    {entries.length === 0 && <p class="empty-state">Tem espaço reservado neste inventário. As próximas histórias chegam em breve.</p>}
  </main>
</BaseLayout>
