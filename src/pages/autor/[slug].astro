---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { articles, authorPath, authors, url } from "../../data/content.js";

export function getStaticPaths() {
  return authors.map((author) => ({ params: { slug: author.slug }, props: { author } }));
}

const { author } = Astro.props;
const entries = articles.filter((article) => article.author === author.slug);
const schema = { "@context": "https://schema.org", "@type": "ProfilePage", mainEntity: { "@type": "Person", name: author.name, description: author.bio, image: author.image, url: new URL(authorPath(author), Astro.site).href, sameAs: author.social ? [author.social] : [] } };
---

<BaseLayout title={`${author.name} — Somos Inventário`} description={author.bio} image={author.image} schema={schema}>
  <main id="main-content" class="archive-page container">
    <nav class="breadcrumbs" aria-label="Você está em"><a href={url("/")}>Início</a><span aria-hidden="true">/</span><span>Quem escreve</span></nav>
    <header class="author-profile"><img src={author.image} alt={author.name} width="140" height="140" /><div><span class="eyebrow">Gente por trás das histórias</span><h1>{author.name}</h1><span class="author-role">{author.role}</span><p>{author.bio}</p>{author.social && <a class="section-link" href={author.social} target="_blank" rel="noreferrer">Instagram ↗</a>}</div></header>
    <div class="section-heading"><div><span class="eyebrow">Do caderno de {author.name.split(" ")[0]}</span><h2>Matérias <em>publicadas</em></h2></div><span class="archive-count">{entries.length} {entries.length === 1 ? "matéria" : "matérias"}</span></div>
    <div class="card-grid">{entries.map((article, index) => <ArticleCard article={article} index={index} />)}</div>
  </main>
</BaseLayout>
